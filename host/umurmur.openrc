#!/sbin/openrc-run

name="uMurmur"
description="Minimalistic Mumble server"

pidfile="/run/umurmurd/umurmurd.pid"
command="/usr/bin/umurmurd"
command_args="-d -c /etc/umurmur/umurmurd.conf -p ${pidfile} ${UMURMURD_OPTS}"
command_background=true
supervisor="supervise-daemon"
respawn_delay=2
respawn_max=0

depend() {
        need net
        use logger
}

start_pre() {
        checkpath -d -o umurmur ${pidfile%/*}
}
